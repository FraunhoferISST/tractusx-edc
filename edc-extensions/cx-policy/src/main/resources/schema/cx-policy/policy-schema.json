{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "CatenaXPolicySchema",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/CatenaXPolicy"
    }
  ],
  "$id": "https://w3id.org/catenax/2025/9/policy/schema/policy-schema.json",
  "$defs": {
    "CatenaXPolicy": {
      "allOf": [
        {
          "$ref": "https://w3id.org/dspace/2025/1/negotiation/contract-schema.json#/$defs/PolicyClass"
        },
        {
          "anyOf": [
            {
              "$ref": "#/$defs/AccessPolicy"
            },
            {
              "$ref": "#/$defs/UsagePolicy"
            }
          ]
        }
      ]
    },
    "AccessPolicy": {
      "type": "object",
      "properties": {
        "permission": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "https://w3id.org/dspace/2025/1/negotiation/contract-schema.json#/$defs/Rule"
              },
              {
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "access"
                  },
                  "constraint": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/AccessPermissionConstraint"
                    },
                    "uniqueItems": true
                  }
                }
              }
            ]
          },
          "minItems": 0
        },
        "prohibition": {
          "type": "array",
          "maxItems": 0
        },
        "obligation": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "AccessPermissionConstraint": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/AccessPermissionLogicalConstraint"
        },
        {
          "$ref": "https://w3id.org/catenax/2025/9/policy/schema/atomic-constraint-schemas.json#/$defs/AtomicAccessPermissionConstraint"
        }
      ]
    },
    "AccessPermissionLogicalConstraint": {
      "type": "object",
      "properties": {
        "and": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccessPermissionConstraint"
          }
        }
      },
      "required": [
        "and"
      ]
    },
    "UsagePolicy": {
      "type": "object",
      "properties": {
        "permission": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "https://w3id.org/dspace/2025/1/negotiation/contract-schema.json#/$defs/Rule"
              },
              {
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "use"
                  },
                  "constraint": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "$ref": "#/$defs/UsagePermissionConstraint"
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "constraint"
                ]
              }
            ]
          },
          "minItems": 1,
          "maxItems": 1
        },
        "prohibition": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "https://w3id.org/dspace/2025/1/negotiation/contract-schema.json#/$defs/Rule"
              },
              {
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "use"
                  },
                  "constraint": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "$ref": "#/$defs/UsageProhibitionConstraint"
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "constraint"
                ]
              }
            ]
          },
          "minItems": 1
        },
        "obligation": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "https://w3id.org/dspace/2025/1/negotiation/contract-schema.json#/$defs/Rule"
              },
              {
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "use"
                  },
                  "constraint": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "anyOf": [
                        {
                          "$ref": "https://w3id.org/catenax/2025/9/policy/data-provisioning-end-duration-days-constraint-schema.json"
                        },
                        {
                          "$ref": "https://w3id.org/catenax/2025/9/policy/data-provisioning-end-date-constraint-schema.json"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "constraint"
                ]
              }
            ]
          },
          "minItems": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "permission"
          ]
        },
        {
          "required": [
            "prohibition"
          ]
        },
        {
          "required": [
            "obligation"
          ]
        }
      ]
    },
    "UsagePermissionConstraint": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/UsagePermissionLogicalConstraint"
        },
        {
          "$ref": "https://w3id.org/catenax/2025/9/policy/schema/atomic-constraint-schemas.json#/$defs/AtomicUsagePermissionConstraint"
        }
      ]
    },
    "UsagePermissionLogicalConstraint": {
      "type": "object",
      "properties": {
        "and": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UsagePermissionConstraint"
          },
          "uniqueItems": true,
          "allOf": [
            {
              "description": "Rule 1: Maximum ONE Warranty constraint allowed",
              "contains": {
                "anyOf": [
                  { "$ref": "https://w3id.org/catenax/2025/9/policy/warranty-duration-constraint-schema.json" },
                  { "$ref": "https://w3id.org/catenax/2025/9/policy/warranty-definition-constraint-schema.json" }
                ]
              },
              "maxContains": 1,
              "minContains": 0
            },
            {
              "description": "Rule 2: Maximum ONE Data Usage End constraint allowed",
              "contains": {
                "anyOf": [
                  { "$ref": "https://w3id.org/catenax/2025/9/policy/data-usage-end-duration-days-constraint-schema.json" },
                  { "$ref": "https://w3id.org/catenax/2025/9/policy/data-usage-end-date-constraint-schema.json" },
                  { "$ref": "https://w3id.org/catenax/2025/9/policy/data-usage-end-definition-constraint-schema.json" }
                ]
              },
              "maxContains": 1,
              "minContains": 0
            }
          ]
        }
      },
      "required": [
        "and"
      ]
    },
    "UsageProhibitionConstraint": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/UsageProhibitionLogicalConstraint"
        },
        {
          "$ref": "https://w3id.org/catenax/2025/9/policy/schema/atomic-constraint-schemas.json#/$defs/AtomicProhibitionConstraint"
        }
      ]
    },
    "UsageProhibitionLogicalConstraint": {
      "type": "object",
      "properties": {
        "and": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UsageProhibitionConstraint"
          }
        }
      },
      "required": [
        "and"
      ]
    }
  }
}
